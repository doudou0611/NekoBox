{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NekoBox",
  "version": "0.3.0",
  "identifier": "dev.galgame.manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "NekoBox",
        "transparent": true,
        "backgroundColor": "#00000000",
        "theme": "Light",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' cover: http://cover.localhost https://cover.localhost screenshot: http://screenshot.localhost https://screenshot.localhost asset: http://asset.localhost https://asset.localhost data: https://lain.bgm.tv https://t.vndb.org https://images.yurari.moe https://imagesp.yurari.moe https://hikarinagi.org https://*.hikarinagi.org; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../licenses/": "licenses/"
    },
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "NekoBox",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxQ0I0NTQwMDk5NjU5ODkKUldTSldaWUpRRVhMd1lZWmJPSGdwS08rVDY0UVJuMDJ1a3htSmh2UDVVK2tWMU1ZSXQ1SW1sSTQK",
      "endpoints": [
        "https://github.com/doudou0611/NekoBox/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
