{
  "name": "galgame-manager",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0 <27",
    "pnpm": "12.4.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test scripts/release-update.test.mjs",
    "test:watch": "vitest",
    "test:browser": "node scripts/verify-preview.mjs",
    "test:gallery-transitions": "node scripts/verify-gallery-transitions.mjs",
    "test:activity": "node scripts/verify-activity.mjs",
    "test:metadata-search": "node scripts/verify-metadata-search.mjs",
    "test:screenshots": "node scripts/verify-screenshots.mjs",
    "test:import-scraping": "node scripts/verify-import-scraping.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-windows.mjs all",
    "desktop:build:x64": "node scripts/build-windows.mjs x64",
    "desktop:build:arm64": "node scripts/build-windows.mjs arm64",
    "release:licenses": "node scripts/release-licenses.mjs",
    "release:package": "node scripts/package-windows.mjs",
    "rust:check": "node scripts/rust.mjs check --locked --manifest-path src-tauri/Cargo.toml",
    "rust:test": "node scripts/rust.mjs test --locked --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "node scripts/rust.mjs fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:lint": "node scripts/rust.mjs clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "env:check": "node scripts/doctor.mjs",
    "test:database-transfer": "node scripts/verify-database-transfer.mjs",
    "test:accounts": "node scripts/verify-accounts.mjs",
    "test:account-cards": "node scripts/verify-account-cards.mjs",
    "release:manifest": "node scripts/release-update.mjs",
    "release:verify": "node scripts/release-update.mjs --verify",
    "test:ui-style": "node scripts/verify-ui-style.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@vueuse/core": "15.0.0",
    "pinia": "4.0.3",
    "reka-ui": "2.10.5",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  }
}
